PORT=3000

# Postgres connection string. Phase 1 creates this database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pdf_rag

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Must match the vector(N) column created in Phase 1. Do not change after ingesting.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Generation model. gemini-3.6-flash is the current default; each model has its
# OWN free-tier daily quota, so switching here is the fix when one is exhausted.
# Verify a model id against your key before trusting it - a retired model fails
# with a 404 only at generation time, after retrieval has already been paid for.
CHAT_MODEL=gemini-3.6-flash
